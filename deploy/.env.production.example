# Template .env produksi backend (Oracle Cloud / VPS)
# Salin ke /var/www/webgis/backend/.env lalu isi. JANGAN commit .env asli.
NODE_ENV=production
PORT=5000
DATABASE_URL="postgresql://webgis:GANTI-PASSWORD-DATABASE@localhost:5432/webgis?schema=public"
JWT_SECRET="GANTI-DENGAN-64-KARAKTER-RANDOM"
ALLOWED_ORIGIN=https://webgis-kepri.vercel.app
STORAGE_DRIVER=supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=GANTI-DENGAN-SERVICE-ROLE-KEY
SUPABASE_BUCKET=uploads
