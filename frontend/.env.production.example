# ═══════════════════════════════════════════════════════════════
# Template environment PRODUKSI frontend (Vercel → Settings → Environment Variables)
# WAJIB diset SEBELUM `npm run build` karena nilainya ditanam saat build.
# ═══════════════════════════════════════════════════════════════

# URL API produksi (dari Render/Railway), wajib pakai https dan diakhiri /api
NEXT_PUBLIC_API_BASE_URL=https://webgis-api.onrender.com/api

# Hanya diisi jika STORAGE_DRIVER=supabase di backend:
# URL project Supabase (tanpa garis miring di akhir), contoh: https://xxxxx.supabase.co
NEXT_PUBLIC_MEDIA_BASE_URL=
