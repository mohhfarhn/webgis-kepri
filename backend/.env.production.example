# ═══════════════════════════════════════════════════════════════
# Template environment PRODUKSI backend (Render / Railway / VPS)
# Salin isi file ini ke "Environment Variables" di dashboard layanan,
# JANGAN commit file .env asli ke Git.
# ═══════════════════════════════════════════════════════════════

# ── Database (Neon/Supabase/Postgres) ──
# Contoh Neon: postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/webgis?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Keamanan ──
# Wajib diganti! Buat dengan: openssl rand -hex 32  (atau generator acak 64 karakter)
JWT_SECRET="GANTI-DENGAN-64-KARAKTER-ACAK"

# ── CORS: domain frontend produksi, pisahkan dengan koma bila lebih dari satu ──
ALLOWED_ORIGIN=https://webgis-kepri.vercel.app

# ── Server ──
PORT=5000
NODE_ENV=production

# ── Storage gambar ──
# local    : file di disk server (HILANG saat redeploy di Render free)
# supabase : Supabase Storage (foto permanen, gratis 1GB) — buat bucket PUBLIC bernama "uploads"
STORAGE_DRIVER=local
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   (Dashboard > Settings > API > service_role — rahasia!)
# SUPABASE_BUCKET=uploads
